# Project Armadillo Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Never commit actual .env files containing production secrets.

# Blind TCP Relay Networking
RELAY_HOST=127.0.0.1
RELAY_PORT=5000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# Local AI Endpoint Configuration (Ollama)
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
